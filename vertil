#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
# vertil — Lanzador rapido de Vertil OS desde Termux
# ============================================================
# CAPA: TERMUX (obligatorio)
# PROPOSITO: Entra a Debian y ejecuta vertil-start
# Uso: ./vertil
# ============================================================

set -eo pipefail

# Regla: Solo valido si existe $TERMUX_VERSION
if [ -z "${TERMUX_VERSION:-}" ]; then
    echo ""
    echo "  ERROR: Este lanzador solo funciona en Termux."
    echo ""
    exit 1
fi

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"

# ============================================================
# FUNCION: Verificar si Debian esta instalado
#    Metodo UNICO: proot-distro list
#    Maneja todos los formatos de salida conocidos
# ============================================================

debian_is_installed() {
    local list_output
    list_output=$(proot-distro list 2>/dev/null) || return 1

    # Formato 1: "debian [installed]" o "debian - installed" en la misma linea
    if echo "$list_output" | grep -i "debian" | grep -qi "installed"; then
        return 0
    fi

    # Formato 2: Seccion "Installed distributions:" seguida de "debian"
    if echo "$list_output" | sed -n '/Installed/,${p}' | grep -q "debian"; then
        return 0
    fi

    # Formato 3: "debian" en una linea y "installed" en la siguiente
    if echo "$list_output" | grep -A1 "debian" | grep -qi "installed"; then
        return 0
    fi

    return 1
}

# Verificar que Debian esta instalado
if ! debian_is_installed; then
    echo ""
    echo "  ERROR: Debian no esta instalado."
    echo "  Ejecuta primero: bash vertil-build.sh"
    echo ""
    exit 1
fi

# Detectar donde esta vertil-os
REPO_DIR=""
if [ -d "${HOME}/vertil-os" ]; then
    REPO_DIR="${HOME}/vertil-os"
elif [ -d "$(dirname "$0")" ] && [ -f "$(dirname "$0")/vertil-start" ]; then
    REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
else
    echo ""
    echo "  ERROR: No se encontro el directorio de Vertil OS."
    echo "  Clona el repositorio o navega al directorio correcto."
    echo ""
    exit 1
fi

echo ""
echo "  Iniciando Vertil OS..."
echo "  Directorio: ${REPO_DIR}"
echo ""

# Entrar a Debian con el repositorio montado y ejecutar vertil-start
proot-distro login debian \
    --bind "${REPO_DIR}":/root/vertil-os \
    -- bash -c "cd /root/vertil-os && ./vertil-start"
