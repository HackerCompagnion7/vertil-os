#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
# vertil — Lanzador rapido de Vertil OS desde Termux
# ============================================================
# CAPA: TERMUX (obligatorio)
# PROPOSITO: Entra a Debian y ejecuta vertil-start
# Uso: ./vertil
# ============================================================

set -eo pipefail

# Regla: Solo valido si existe $TERMUX_VERSION
if [ -z "${TERMUX_VERSION:-}" ]; then
    echo ""
    echo "  ERROR: Este lanzador solo funciona en Termux."
    echo ""
    exit 1
fi

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"

# ============================================================
# FUNCION: Verificar si Debian esta instalado
#    Multi-metodo: proot-distro list + login fallback
# ============================================================

debian_is_installed() {
    local output

    # Capturar salida de proot-distro list (stdout + stderr)
    output=$(proot-distro list 2>&1) || true

    # Eliminar codigos ANSI
    output=$(printf '%s' "$output" | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g')

    # Metodo 1: "debian" con "install" en la misma linea
    if printf '%s\n' "$output" | grep -i "debian" | grep -qi "install"; then
        return 0
    fi

    # Metodo 2: Contar ocurrencias de "debian" (2+ = instalado)
    local count
    count=$(printf '%s\n' "$output" | grep -ci "debian" 2>/dev/null || true)
    count=$(echo "$count" | tr -cd '0-9')
    if [ "${count:-0}" -ge 2 ]; then
        return 0
    fi

    # Metodo 3: Seccion "Installed distributions:" con "debian"
    if printf '%s\n' "$output" | awk '
        /[Ii]nstalled.*:/ { in_installed=1; next }
        /^[A-Z]/ { in_installed=0 }
        in_installed && /debian/ { exit 0 }
        END { exit 1 }
    ' 2>/dev/null; then
        return 0
    fi

    # Metodo 4: Login test (definitivo)
    if proot-distro login debian -- true 2>/dev/null; then
        return 0
    fi

    return 1
}

# Verificar que Debian esta instalado
if ! debian_is_installed; then
    echo ""
    echo "  ERROR: Debian no esta instalado."
    echo "  Ejecuta primero: bash vertil-build.sh"
    echo ""
    exit 1
fi

# Detectar donde esta vertil-os
REPO_DIR=""
if [ -d "${HOME}/vertil-os" ]; then
    REPO_DIR="${HOME}/vertil-os"
elif [ -d "$(dirname "$0")" ] && [ -f "$(dirname "$0")/vertil-start" ]; then
    REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
else
    echo ""
    echo "  ERROR: No se encontro el directorio de Vertil OS."
    echo "  Clona el repositorio o navega al directorio correcto."
    echo ""
    exit 1
fi

echo ""
echo "  Iniciando Vertil OS..."
echo "  Directorio: ${REPO_DIR}"
echo ""

# Entrar a Debian con el repositorio montado
# chmod +x obligatorio: bind mount no preserva permisos de ejecucion
proot-distro login debian \
    --bind "${REPO_DIR}":/root/vertil-os \
    -- bash -c "chmod +x /root/vertil-os/vertil-start && cd /root/vertil-os && ./vertil-start"
