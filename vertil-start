#!/bin/bash
# ============================================================
# vertil-start — Runtime de Vertil OS (Fase 1)
# ============================================================
# CAPA: DEBIAN (obligatorio)
# PROPOSITO: Iniciar Xvfb, Openbox, Tint2 y VNC
# REGLA: Solo se ejecuta en Debian/proot. Aborta si detecta Termux.
# PROHIBIDO: proot-distro, $PREFIX, variables de Termux
# PROHIBIDO: x0vncserver (incompatible con Xvfb)
# VNC: Solo x11vnc (compatible con display virtual Xvfb)
# ============================================================

set -eo pipefail

# ============================================================
# 1. VERIFICACION DE ENTORNO — DEBIAN OBLIGATORIO
# ============================================================

# Regla: Solo valido si NO existe $TERMUX_VERSION
if [ -n "${TERMUX_VERSION:-}" ]; then
    echo ""
    echo "  ERROR: Se detecto \$TERMUX_VERSION."
    echo "  Este script se ejecuta DENTRO de Debian, no en Termux."
    echo ""
    echo "  Desde Termux, entra a Debian con:"
    echo "    proot-distro login debian --bind ~/vertil-os:/root/vertil-os"
    echo ""
    echo "  O usa el lanzador rapido:"
    echo "    ./vertil"
    echo ""
    exit 1
fi

# REGLA CRITICA: SI entorno == Debian Y proot-distro en ejecucion → ABORTAR
if command -v proot-distro &>/dev/null; then
    echo "[BLOCKED] proot-distro dentro de Debian"
    exit 1
fi

# Verificar que estamos en un entorno Linux con los binarios necesarios
CRITICAL_MISSING=""
for cmd in Xvfb openbox xterm x11vnc; do
    if ! command -v "$cmd" &>/dev/null; then
        CRITICAL_MISSING="${CRITICAL_MISSING} ${cmd}"
    fi
done

if [ -n "${CRITICAL_MISSING}" ]; then
    echo ""
    echo "  ERROR: Faltan comandos criticos:${CRITICAL_MISSING}"
    echo "  Los paquetes no se instalaron correctamente."
    echo "  Ejecuta desde Termux: bash vertil-build.sh"
    echo ""
    exit 1
fi

# ============================================================
# 2. CONSTANTES (todas definidas localmente, sin Termux)
# ============================================================
DISPLAY_NUM=":0"
RESOLUTION="1280x720x24"
VNC_PORT="5901"
LOG_DIR="/root/.vertil/logs"
PID_FILE="/root/.vertil/pids"
READY_FLAG="/root/.vertil/ready"

# Colores para terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================
# 3. DIRECTORIOS Y LOG
# ============================================================
mkdir -p "${LOG_DIR}"

MAIN_LOG="${LOG_DIR}/vertil-$(date +%Y%m%d-%H%M%S).log"

log() {
    local level="$1"; shift
    local msg="$*"
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[${ts}] [${level}] ${msg}" | tee -a "${MAIN_LOG}"
}

info()  { log "INFO"  "$@"; }
warn()  { log "WARN"  "$@"; }
error() { log "ERROR" "$@"; }

# ============================================================
# 4. LIMPIEZA DE ESTADO ANTERIOR
# ============================================================
rm -f "${PID_FILE}"
rm -f "${READY_FLAG}"

# ============================================================
# 5. FUNCION DE LIMPIEZA (Ctrl+C)
# ============================================================
cleanup() {
    echo ""
    info "Senal de terminacion recibida. Limpiando procesos..."

    # Matar procesos del archivo PID
    if [ -f "${PID_FILE}" ]; then
        while IFS= read -r entry; do
            local name pid
            name=$(echo "$entry" | cut -d: -f1 | tr -d ' ')
            pid=$(echo "$entry" | cut -d: -f2 | tr -d ' ')
            if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
                info "Deteniendo ${name} (PID ${pid})..."
                kill "${pid}" 2>/dev/null || true
                sleep 0.2
            fi
        done < "${PID_FILE}"
        rm -f "${PID_FILE}"
    fi

    # Limpieza residual
    pkill -f "Xvfb" 2>/dev/null || true
    pkill -f "x11vnc" 2>/dev/null || true
    pkill -f "openbox" 2>/dev/null || true
    pkill -f "tint2" 2>/dev/null || true

    rm -f "${READY_FLAG}"

    info "Limpieza completada. Vertil OS detenido."
    exit 0
}

trap cleanup SIGINT SIGTERM

# Inicializar archivo de PIDs
> "${PID_FILE}"

# ============================================================
# 6. PREPARAR ENTORNO X11
# ============================================================
mkdir -p /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix 2>/dev/null || true
mkdir -p /root/.vnc

# ============================================================
# 7. INICIAR Xvfb
# ============================================================
info "Iniciando Xvfb en display ${DISPLAY_NUM} (${RESOLUTION})..."

Xvfb "${DISPLAY_NUM}" \
    -screen 0 "${RESOLUTION}" \
    -ac \
    +extension GLX \
    +extension RENDER \
    -noreset \
    >> "${LOG_DIR}/xvfb.log" 2>&1 &
XVFB_PID=$!
echo "Xvfb:${XVFB_PID}" >> "${PID_FILE}"

sleep 1.5

if ! kill -0 "${XVFB_PID}" 2>/dev/null; then
    error "Xvfb no pudo iniciarse. Ver ${LOG_DIR}/xvfb.log"
    cleanup
    exit 1
fi

info "Xvfb iniciado (PID ${XVFB_PID})"

# ============================================================
# 8. ESTABLECER DISPLAY
# ============================================================
export DISPLAY="${DISPLAY_NUM}"

# ============================================================
# 9. INICIAR Openbox
# ============================================================
info "Iniciando Openbox..."

openbox \
    >> "${LOG_DIR}/openbox.log" 2>&1 &
OPENBOX_PID=$!
echo "Openbox:${OPENBOX_PID}" >> "${PID_FILE}"

sleep 1.5

if ! kill -0 "${OPENBOX_PID}" 2>/dev/null; then
    error "Openbox no pudo iniciarse. Ver ${LOG_DIR}/openbox.log"
    cleanup
    exit 1
fi

info "Openbox iniciado (PID ${OPENBOX_PID})"

# ============================================================
# 10. INICIAR TINT2 (no critico)
# ============================================================
info "Iniciando Tint2..."

if command -v tint2 &>/dev/null; then
    tint2 \
        >> "${LOG_DIR}/tint2.log" 2>&1 &
    TINT2_PID=$!
    echo "Tint2:${TINT2_PID}" >> "${PID_FILE}"

    sleep 1
    if kill -0 "${TINT2_PID}" 2>/dev/null; then
        info "Tint2 iniciado (PID ${TINT2_PID})"
    else
        info "AVISO: Tint2 no pudo iniciarse (no critico para Fase 1)"
    fi
else
    info "AVISO: tint2 no encontrado. Barra no disponible."
fi

# ============================================================
# 11. INICIAR SERVIDOR VNC
#    UNICO BACKEND: x11vnc
#    x0vncserver ELIMINADO — incompatible con Xvfb (display virtual)
#    x11vnc es compatible con Xvfb (comparte display existente)
# ============================================================
info "Iniciando x11vnc en puerto ${VNC_PORT}..."

x11vnc \
    -display "${DISPLAY_NUM}" \
    -rfbport "${VNC_PORT}" \
    -nopw \
    -forever \
    -shared \
    -noxrecord \
    -noxdamage \
    >> "${LOG_DIR}/vnc.log" 2>&1 &
VNC_PID=$!
echo "VNC:${VNC_PID}" >> "${PID_FILE}"

sleep 2

if ! kill -0 "${VNC_PID}" 2>/dev/null; then
    error "x11vnc no pudo iniciarse. Ver ${LOG_DIR}/vnc.log"
    cleanup
    exit 1
fi

info "x11vnc iniciado (PID ${VNC_PID})"

# ============================================================
# 12. FLAG DE LISTO
# ============================================================
date '+%Y-%m-%d %H:%M:%S' > "${READY_FLAG}"
info "Todos los servicios estan en ejecucion."

# ============================================================
# 13. MOSTRAR INFORMACION DE CONEXION
# ============================================================

LOCAL_IP=""

# Intentar obtener IP (dentro de proot comparte red con Android)
if command -v ip &>/dev/null; then
    LOCAL_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -1)
fi
if [ -z "${LOCAL_IP}" ] && command -v ifconfig &>/dev/null; then
    LOCAL_IP=$(ifconfig 2>/dev/null | grep 'inet ' | grep -v '127.0.0.1' | head -1 | awk '{print $2}' | sed 's/addr://')
fi
if [ -z "${LOCAL_IP}" ]; then
    LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
fi
if [ -z "${LOCAL_IP}" ]; then
    LOCAL_IP="localhost"
fi

echo ""
echo -e "${GREEN}  +------------------------------------------+${NC}"
echo -e "${GREEN}  |  Vertil OS esta en ejecucion             |${NC}"
echo -e "${GREEN}  +------------------------------------------+${NC}"
echo -e "${GREEN}  |                                          |${NC}"
echo -e "${GREEN}  |  VNC: ${BOLD}${LOCAL_IP}:${VNC_PORT}${NC}                      "
echo -e "${GREEN}  |  Display: ${BOLD}${DISPLAY_NUM}${NC}                       "
echo -e "${GREEN}  |  Resolucion: 1280x720                   |${NC}"
echo -e "${GREEN}  |  Backend: x11vnc                        |${NC}"
echo -e "${GREEN}  |  Seguridad: Ninguna (Fase 1)            |${NC}"
echo -e "${GREEN}  |                                          |${NC}"
echo -e "${GREEN}  |  Presione ${BOLD}Ctrl+C${NC} para detener            "
echo -e "${GREEN}  +------------------------------------------+${NC}"
echo ""

# Codigo QR si qrencode esta disponible
if command -v qrencode &>/dev/null; then
    echo -e "${YELLOW}  Codigo QR:${NC}"
    qrencode -t ANSIUTF8 "vnc://${LOCAL_IP}:${VNC_PORT}" 2>/dev/null || true
    echo ""
fi

# ============================================================
# 14. MONITOREO DE PROCESOS
# ============================================================
info "Monitoreando servicios... (Ctrl+C para detener)"

while true; do
    # Xvfb es critico — si muere, todo muere
    if ! kill -0 "${XVFB_PID}" 2>/dev/null; then
        error "Xvfb ha muerto. Deteniendo sistema."
        break
    fi

    # Openbox — auto-reinicio
    if ! kill -0 "${OPENBOX_PID}" 2>/dev/null; then
        info "Openbox ha muerto. Reiniciando..."
        openbox >> "${LOG_DIR}/openbox.log" 2>&1 &
        OPENBOX_PID=$!
        sed -i "s/Openbox:.*/Openbox:${OPENBOX_PID}/" "${PID_FILE}"
        sleep 1
    fi

    # VNC — auto-reinicio con x11vnc
    if ! kill -0 "${VNC_PID}" 2>/dev/null; then
        info "VNC ha muerto. Reiniciando..."
        x11vnc \
            -display "${DISPLAY_NUM}" \
            -rfbport "${VNC_PORT}" \
            -nopw -forever -shared -noxrecord -noxdamage \
            >> "${LOG_DIR}/vnc.log" 2>&1 &
        VNC_PID=$!
        sed -i "s/VNC:.*/VNC:${VNC_PID}/" "${PID_FILE}"
        sleep 1
    fi

    # Tint2 — auto-reinicio (no critico)
    if [ -n "${TINT2_PID:-}" ] && ! kill -0 "${TINT2_PID}" 2>/dev/null; then
        if command -v tint2 &>/dev/null; then
            info "Tint2 ha muerto. Reiniciando..."
            tint2 >> "${LOG_DIR}/tint2.log" 2>&1 &
            TINT2_PID=$!
            sed -i "s/Tint2:.*/Tint2:${TINT2_PID}/" "${PID_FILE}"
            sleep 1
        fi
    fi

    sleep 5
done

error "Saliendo del monitor por fallo critico."
cleanup
